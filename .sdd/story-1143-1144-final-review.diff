+        case .comfortable:
+            self.columnStyle = .fixedCount(2)
+            self.itemSpacing = ToonEdgeSpacing.large
+            self.horizontalContentPadding = ToonEdgeSpacing.large
+        case .compact:
+            self.columnStyle = .fixedCount(4)
+            self.itemSpacing = ToonEdgeSpacing.small
